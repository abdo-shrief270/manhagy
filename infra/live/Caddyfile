{
	email {$ACME_EMAIL}
}

{$LIVE_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Only the main server: its API (rooms, the floor, recordings — LIVEKIT_API_URL = https://<this
	# domain>) and its downloads of finished recordings (LIVEKIT_RECORDINGS_URL = …/recordings, with
	# the API secret as a bearer token).
	handle /twirp/* {
		@other not remote_ip {$MAIN_SERVER_IP}
		respond @other 404
		reverse_proxy livekit:7880
	}
	handle_path /recordings/* {
		@allowed {
			remote_ip {$MAIN_SERVER_IP}
			header Authorization "Bearer {$LIVEKIT_API_SECRET}"
		}
		handle @allowed {
			root * /recordings
			file_server
		}
		respond 404
	}
	# Browsers: the room websocket.
	handle {
		reverse_proxy livekit:7880
	}
}

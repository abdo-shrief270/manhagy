# Copy to .env on the broadcast server.
LIVE_DOMAIN=live.manhagy.online
ACME_EMAIL=you@example.com
# The main server (app + API): its domain for the hook, its IP for recordings / the API.
APP_DOMAIN=app.manhagy.online
MAIN_SERVER_IP=
# The same LIVE_SECRET as the main server's .env.
LIVE_SECRET=
# This server's public IP (browsers send their media to it).
LIVE_PUBLIC_IP=

# Copy to .env on the live server.
LIVE_DOMAIN=live.manhagy.online
ACME_EMAIL=you@example.com
# The main server's public IP: only it may use the server API and download recordings.
MAIN_SERVER_IP=
# This server's public IP (browsers send their media to it).
LIVE_PUBLIC_IP=
# The same key / secret as the main server's LIVEKIT_API_KEY / LIVEKIT_API_SECRET.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OBS: COMPOSE_PROFILES=obs (and LIVEKIT_INGRESS=true on the main server).
COMPOSE_PROFILES=

# The edge: Caddy serving the three Nuxt SPAs (built to static files) and the landing page,
# and proxying /api to the api container. Build context: repository root.

FROM node:22-alpine AS web
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY apps/web/ ./
ARG APP_VERSION=""
ARG SITE_URL=https://manhagy.online
ENV NUXT_PUBLIC_API_BASE=/api/v1 NUXT_PUBLIC_APP_VERSION=$APP_VERSION NUXT_PUBLIC_SITE_URL=$SITE_URL
RUN npx nuxi prepare && npx nuxi generate

FROM node:22-alpine AS learn
WORKDIR /app
COPY apps/learn/package.json apps/learn/package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY apps/learn/ ./
# Each platform is {slug}.<SITES_HOST>; the API on the same origin.
ARG SITES_HOST=manhagy.online
ENV NUXT_PUBLIC_API_BASE=/api/v1 NUXT_PUBLIC_SITES_HOST=$SITES_HOST
RUN npx nuxi prepare && npx nuxi generate

FROM node:22-alpine AS admin
WORKDIR /app
COPY apps/admin/package.json apps/admin/package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY apps/admin/ ./
ENV NUXT_PUBLIC_API_BASE=/api/v1
RUN npx nuxi prepare && npx nuxi generate && node scripts/csp.mjs > .output/admin-csp.caddy

FROM caddy:2-alpine
COPY infra/production/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /app/.output/public /srv
COPY --from=learn /app/.output/public /srv-learn
COPY --from=admin /app/.output/public /srv-admin
COPY --from=admin /app/.output/admin-csp.caddy /etc/caddy/admin-csp.caddy
# The teachers' landing page (site/, built by src/site.py).
COPY site/ /srv-site

# Copy to .env (./init.sh does it and fills the secrets for you).

# --- Server ---
# The root domain: the landing page, and the students' platforms on {slug}.<this>.
SITES_HOST=manhagy.online
# The teachers' app + the API.
APP_DOMAIN=app.manhagy.online
# The admin panel's own domain (point its DNS here too). Empty = no admin panel.
ADMIN_DOMAIN=
# Only these IPs / ranges may reach the admin panel (comma separated). Optional.
ADMIN_ALLOWED_IPS=
# «سوق منهجي»: the marketplace site (point its DNS here; it must not be a teacher's slug — «courses» is reserved).
# Empty = no marketplace yet. MARKET_URL is what the teachers' app links to.
MARKET_DOMAIN=
MARKET_URL=
# The landing page: "manhagy.online, www.manhagy.online" (empty = not served by this stack).
LANDING_ADDRESS=
ACME_EMAIL=you@example.com

# --- Laravel ---
APP_NAME=Manhagy
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.manhagy.online
FRONTEND_URL=https://app.manhagy.online
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=manhagy
DB_USERNAME=manhagy
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# Sign-up: open to everyone, or closed (teachers ask on WhatsApp, the team opens their account).
SIGNUP_OPEN=false
SIGNUP_WHATSAPP=

# Subscriptions: where teachers send InstaPay payments (shown on the billing page)
BILLING_INSTAPAY_ADDRESS=
BILLING_INSTAPAY_NAME=

# Videos live on this server: uploaded in chunks, encoded by ffmpeg into encrypted HLS (360/720/1080p
# up to the original), served by the API. VIDEO_WORKERS = videos encoded at the same time (each takes
# the CPU); VIDEO_MAX_MB = the biggest upload. Disk: about 2.4 GB per hour of a 1080p original
# (all its renditions), 0.9 GB for 720p.
VIDEO_DRIVER=local
VIDEO_WORKERS=1
VIDEO_MAX_MB=4096
VIDEO_KEEP_SOURCE=false

# Students confirm their phone by sending a WhatsApp message to this number (empty = no confirmation).
# Webhook for Meta's WhatsApp Cloud API: https://<APP_DOMAIN>/api/v1/public/whatsapp/webhook
VERIFY_WHATSAPP=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Server alerts on Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backups
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=
